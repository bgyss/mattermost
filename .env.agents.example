# Copy this to .env.agents (gitignored) and fill in your values.
# mise will auto-load .env.agents when running any `mise run agents:*` task.

# ── OpenClaw gateway ───────────────────────────────────────────────────────────
# Token for the local OpenClaw gateway (http://127.0.0.1:18789 by default)
MM_AGENTS_OPENCLAW_TOKEN=

# Override gateway URL if running on a non-default port
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789

# ── Mattermost admin credentials (used by provision script) ───────────────────
MM_ADMIN_EMAIL=admin@example.com
MM_ADMIN_PASSWORD=

# ── Team name to provision agents into ────────────────────────────────────────
MM_TEAM_NAME=acme

# ── LLM service (openclaw | anthropic | openai) ───────────────────────────────
MM_AGENTS_LLM_SERVICE=openclaw

# ── Uncomment for direct Anthropic fallback ───────────────────────────────────
# MM_AGENTS_ANTHROPIC_API_KEY=sk-ant-...
